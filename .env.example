# Copiază în .env (nu se comite). Pe cPanel: variabile de mediu ale aplicației Node.
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
# Cel puțin 32 de caractere aleatorii; schimbarea lui resetează limitele de trimitere.
IP_HASH_SALT=
# Câte proxy-uri adaugă adresa în X-Forwarded-For înaintea aplicației: 0 local, de obicei 1 pe cPanel/Passenger (verifică pe staging, vezi docs/operare/server.md)
TRUST_PROXY_HOPS=0
# Plafon de cereri pe oră pentru tot site-ul
LEAD_GLOBAL_HOURLY_CAP=60
# Opționale: notificare pe Telegram (setează ambele sau niciuna)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Doar temporar, la verificarea IP-ului pe staging
# DEBUG_CLIENT_IP=true
