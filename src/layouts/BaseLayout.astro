---
import '../styles/tokens.css';
import '../styles/base.css';
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import { getImage } from 'astro:assets';
import { ConsentDefaults, CookieConsent } from '@features/consent';
import { UtmCapture } from '@features/lead-capture';
import { photos } from '@shared/content/photos';
import { site } from '@shared/content/site';
import { withBase } from '@shared/lib/with-base';
import { serializeJsonLd } from '@shared/seo/json-ld';
import { isIndexable, siteEnv } from '@shared/seo/site-env';
import { canonicalUrl, fullTitle, ogImageSize, siteRootUrl } from '@shared/seo/page-meta';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: readonly object[];
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description,
  image = photos.class,
  imageAlt = 'Copii la o lecție de engleză la English Minds Academy',
  type = 'website',
  noindex = false,
  jsonLd = [],
  publishedTime,
  modifiedTime,
} = Astro.props;
const pageTitle = fullTitle(title, site.name);
const root = siteRootUrl(Astro.site, site.url, import.meta.env.BASE_URL);
const canonical = canonicalUrl(Astro.url.pathname, root);
const ogSize = ogImageSize(image);
const ogImage = await getImage({ src: image, ...ogSize, fit: 'cover', format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, root).href;
const hidden = noindex || !isIndexable(siteEnv(import.meta.env.SITE_ENV));
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <ConsentDefaults />
    <Font cssVariable="--font-nunito" preload />
    <Font cssVariable="--font-barlow-condensed" preload />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {hidden && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogSize.width)} />
    <meta property="og:image:height" content={String(ogSize.height)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={serializeJsonLd(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#continut">Sari la conținut</a>
    <slot />
    <UtmCapture />
    <CookieConsent />
  </body>
</html>
