---
import type { ImageMetadata } from 'astro';
import { site } from '@shared/content/site';
import { legalCompanyLine } from '@shared/lib/company-line';
import { withBase } from '@shared/lib/with-base';
import Button from './Button.astro';
import Logo from './Logo.astro';
import { NAV } from './navigation';
import WhatsAppButton from './WhatsAppButton.astro';
import './Footer.css';

interface Props {
  showCta?: boolean;
}

const { showCta = true } = Astro.props;
const { contact } = site;
const PAGES = [...NAV.filter((item) => item.key !== 'acasa'), { label: 'Lecție demo gratuită', href: '/lectie-demo/' }];
const LEGAL = [
  { label: 'Confidențialitate', href: '/confidentialitate/' },
  { label: 'Cookies', href: '/cookies/' },
  { label: 'Termeni', href: '/termeni/' },
];
const year = new Date().getFullYear();
const ANPC_SAL_URL = 'https://reclamatiisal.anpc.ro/';
const ANPC_SAL_LABEL = 'ANPC – Soluționarea alternativă a litigiilor';
const anpcPictogram = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('/src/assets/legal/anpc-sal.*', { eager: true }),
)[0]?.default;
---
<footer class="site-footer">
  <div class="site-footer__inner">
    {showCta && (
      <div class="site-footer__cta">
        <p class="site-footer__title">Rezervă lecția{' '}<span class="site-footer__highlight">demo gratuită</span></p>
        <div class="site-footer__actions">
          <WhatsAppButton />
          <Button href={`tel:${contact.phoneE164}`} variant="sun">{contact.phoneDisplay}</Button>
        </div>
      </div>
    )}
    <div class="site-footer__columns">
      <div class="site-footer__brand">
        <Logo />
        <p class="site-footer__tagline">Cursuri de engleză pentru copii de 5–14 ani, după metoda Cambridge, în {contact.city}.</p>
        <a class="site-footer__social" href={contact.instagramUrl} target="_blank" rel="noopener noreferrer">
          <svg class="site-footer__social-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="17.4" cy="6.6" r="1.3" fill="currentColor" />
          </svg>
          <span>Urmărește-ne pe Instagram</span>
          <span class="visually-hidden">(se deschide într-un tab nou)</span>
        </a>
      </div>
      <nav class="site-footer__col" aria-labelledby="footer-pages">
        <p class="site-footer__heading" id="footer-pages">Pagini</p>
        <ul>
          {PAGES.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
        </ul>
      </nav>
      <div class="site-footer__col">
        <p class="site-footer__heading">Contact</p>
        <address>
          <ul>
            <li><a href={`tel:${contact.phoneE164}`}>{contact.phoneDisplay}</a></li>
            <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li><a href={contact.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp<span class="visually-hidden"> (se deschide într-un tab nou)</span></a></li>
            <li><a href={contact.instagramUrl} target="_blank" rel="noopener noreferrer">{contact.instagramHandle}<span class="visually-hidden"> pe Instagram (se deschide într-un tab nou)</span></a></li>
            <li>
              {`${contact.street}, ${contact.city}`}
              <br />
              <a class="site-footer__map" href={contact.mapsUrl} target="_blank" rel="noopener noreferrer">Vezi pe hartă →<span class="visually-hidden"> (se deschide într-un tab nou)</span></a>
            </li>
          </ul>
        </address>
      </div>
    </div>
    <a class="site-footer__anpc" href={ANPC_SAL_URL} target="_blank" rel="noopener noreferrer">
      {anpcPictogram
        ? <img src={anpcPictogram.src} width="250" height="50" alt={ANPC_SAL_LABEL} />
        : <span>{ANPC_SAL_LABEL}</span>}
      <span class="visually-hidden"> (se deschide într-un tab nou)</span>
    </a>
    <div class="site-footer__bottom">
      <p class="site-footer__copy">© {year} {site.name}</p>
      <nav class="site-footer__legal" aria-label="Informații legale">
        <ul>
          {LEGAL.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
          <li><button type="button" class="site-footer__cookie-settings" data-cc="show-preferencesModal">Setări cookies</button></li>
        </ul>
      </nav>
      <p class="site-footer__company">{legalCompanyLine(site.company)}</p>
    </div>
  </div>
</footer>
