---
import { withBase } from '@shared/lib/with-base';
import Logo from './Logo.astro';
import { NAV, type NavKey } from './navigation';
import './Header.css';

interface Props {
  active?: NavKey;
}

const { active } = Astro.props;
---
<header class="site-header">
  <site-menu class="site-header__inner">
    <Logo />
    <nav id="site-nav" class="site-header__nav" aria-label="Principal">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={withBase(item.href)} aria-current={item.key === active ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="site-header__cta" href={withBase('/lectie-demo/')}>Rezervă locul acum</a>
    <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
      <span class="site-header__bars" aria-hidden="true"></span>
      <span class="visually-hidden">Meniu</span>
    </button>
  </site-menu>
</header>

<script>
  import { defineSiteMenu } from './site-menu.element';
  defineSiteMenu();
</script>
