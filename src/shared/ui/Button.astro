---
import { withBase } from '@shared/lib/with-base';
import './Button.css';

interface Props {
  href: string;
  variant?: 'primary' | 'sun' | 'navy' | 'outline' | 'outline-light' | 'whatsapp';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;
---
<a class:list={['button', `button--${variant}`, className]} href={withBase(href)}><slot /></a>
