---
import './Button.css';

interface Props {
  href: string;
  variant?: 'primary' | 'sun' | 'navy' | 'outline' | 'outline-light' | 'whatsapp';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;
---
<a class:list={['button', `button--${variant}`, className]} href={href}><slot /></a>
