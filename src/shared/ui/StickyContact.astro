---
import { site } from '@shared/content/site';
import { withBase } from '@shared/lib/with-base';
import './StickyContact.css';
interface Props {
  demoHref?: string;
  hideWhileVisible?: string;
}

const { demoHref = '/lectie-demo/', hideWhileVisible } = Astro.props;
---
<sticky-contact data-hide-while-visible={hideWhileVisible}>
<nav class="sticky-contact" aria-label="Contact rapid">
  <a class="sticky-contact__whatsapp" href={site.contact.whatsappUrl}>
    <span class="sticky-contact__long">Scrie-ne pe WhatsApp</span>
    <span class="sticky-contact__short">WhatsApp</span>
  </a>
  <a class="sticky-contact__demo" href={withBase(demoHref)}>Lecție demo</a>
</nav>
</sticky-contact>

<script>
  import { defineStickyContact } from './sticky-contact.element';
  defineStickyContact();
</script>
