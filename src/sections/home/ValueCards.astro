---
import { site } from '@shared/content/site';
import Star from '@shared/ui/Star.astro';
import './ValueCards.css';
---
<section class="value-cards" aria-labelledby="valori-heading">
  <h2 id="valori-heading" class="visually-hidden">De ce English Minds</h2>
  <ul>
    {site.values.map((value) => (
      <li class={`value-card value-card--${value.tone}`}>
        <Star tone={value.tone === 'sun' ? 'orange' : 'sun'} size={44} />
        <h3>{value.title}</h3>
        <p>{value.text}</p>
      </li>
    ))}
  </ul>
</section>
