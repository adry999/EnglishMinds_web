---
import { withBase } from '@shared/lib/with-base';
import Button from '@shared/ui/Button.astro';
import EmaPortrait from '@shared/ui/EmaPortrait.astro';
import './EmaTip.css';
---
<aside class="ema-tip" aria-labelledby="ema-tip-heading">
  <EmaPortrait size="sm" alt="" />
  <div class="ema-tip__text">
    <h2 id="ema-tip-heading">Sfatul Emei</h2>
    <p>Nu știi de unde să începi? Fă testul de nivel și îți spunem ce se potrivește copilului tău. Sau <a href={withBase('/lectie-demo/')}>rezervă direct lecția demo gratuită</a>.</p>
  </div>
  <Button variant="sun" class="ema-tip__cta" href="/test-de-nivel/">Fă testul</Button>
</aside>
