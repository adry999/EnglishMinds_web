---
import type { FaqEntry } from '@shared/content/site';
import { withBase } from '@shared/lib/with-base';
import Eyebrow from '@shared/ui/Eyebrow.astro';
import './faq.css';

interface Props {
  items: readonly FaqEntry[];
  heading?: string;
  id?: string;
  eyebrow?: string;
}

const { items, heading = 'Întrebări frecvente', id = 'faq', eyebrow } = Astro.props;
---
<section class="faq" id={id} aria-labelledby={`${id}-heading`}>
  <div class="faq__intro">
    {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
    <h2 id={`${id}-heading`} class="faq__heading">{heading}</h2>
    <slot />
  </div>
  <faq-list>
    {items.map((item, index) => (
      <div class="faq__item">
        <h3 class="faq__question">{item.question}</h3>
        <div class="faq__answer" id={`${id}-answer-${index}`}>
          <p>{item.answer}{item.link && <>{' '}<a href={withBase(item.link.href)}>{item.link.label}</a></>}</p>
        </div>
      </div>
    ))}
  </faq-list>
</section>

<script>
  import { defineFaqList } from './faq.element';
  defineFaqList();
</script>
