---
import BaseLayout from '@layouts/BaseLayout.astro';
import CampDay from '@sections/tabere/CampDay.astro';
import CampIncludes from '@sections/tabere/CampIncludes.astro';
import CampSummary from '@sections/tabere/CampSummary.astro';
import TabereHero from '@sections/tabere/TabereHero.astro';
import Footer from '@shared/ui/Footer.astro';
import Header from '@shared/ui/Header.astro';
---
<BaseLayout
  title="Tabără de vară în engleză, Cluj-Napoca"
  description="Tabără de vară în engleză la English Minds Academy, Cluj-Napoca: jocuri, proiecte și ieșiri tematice, toate în engleză, pentru copii de 5–14 ani."
  crumbs={[{ name: 'Tabere de vară', path: '/tabere/' }]}
>
  <Header active="tabere" />
  <main id="continut" tabindex="-1">
    <TabereHero />
    <CampSummary />
    <CampDay />
    <CampIncludes />
  </main>
  <Footer />
</BaseLayout>
