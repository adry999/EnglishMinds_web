---
import { getImage } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getPublishedPosts, PostArticle, type BlogPost } from '@features/blog';
import { site } from '@shared/content/site';
import { blogPostingJsonLd } from '@shared/seo/json-ld';
import { canonicalUrl, ogImageSize, siteRootUrl } from '@shared/seo/page-meta';
import Footer from '@shared/ui/Footer.astro';
import Header from '@shared/ui/Header.astro';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const root = siteRootUrl(Astro.site, site.url, import.meta.env.BASE_URL);
const cover = await getImage({ src: post.data.cover, ...ogImageSize(post.data.cover), fit: 'cover', format: 'jpg' });
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.publishedAt}
  modifiedTime={post.data.updatedAt}
  image={post.data.cover}
  imageAlt={post.data.coverAlt}
  jsonLd={[
    blogPostingJsonLd({
      headline: post.data.title,
      description: post.data.description,
      url: canonicalUrl(Astro.url.pathname, root),
      image: new URL(cover.src, root).href,
      datePublished: post.data.publishedAt,
      dateModified: post.data.updatedAt,
      organizationUrl: root,
      organizationName: site.name,
    }),
  ]}
>
  <Header active="blog" />
  <main id="continut">
    <PostArticle post={post} />
  </main>
  <Footer />
</BaseLayout>
