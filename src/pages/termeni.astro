---
import { getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import LegalDocument from '@sections/legal/LegalDocument.astro';
import Footer from '@shared/ui/Footer.astro';
import Header from '@shared/ui/Header.astro';

const entry = await getEntry('legal', 'termeni');
if (!entry) throw new Error('Lipsește src/content/legal/termeni.md');
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  crumbs={[{ name: entry.data.title, path: '/termeni/' }]}
>
  <Header />
  <main id="continut">
    <LegalDocument entry={entry} showOfferTerms />
  </main>
  <Footer />
</BaseLayout>
