---
import BaseLayout from '@layouts/BaseLayout.astro';
import { LeadForm } from '@features/lead-capture';
import { LevelTest } from '@features/level-test';
import Footer from '@shared/ui/Footer.astro';
import Header from '@shared/ui/Header.astro';
---
<BaseLayout
  title="Test de nivel"
  description="Test de engleză gratuit pentru copii de 5–14 ani: 12 întrebări adaptate vârstei, cu audio, nivelul recomandat și diplomă la final."
>
  <Header active="test" />
  <main id="continut" class="level-test-page">
    <h1 class="visually-hidden">Test de nivel la engleză pentru copii</h1>
    <LevelTest />
    <div class="level-test-page__lead">
      <LeadForm source="test" tone="cream" title="Rezervă lecția demo gratuită" headingLevel={2} showAgeGroups={false} hidden />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .level-test-page {
    padding: 40px var(--gutter) 80px;
    background: var(--gradient-hero);
  }

  .level-test-page__lead {
    max-width: 720px;
    margin-inline: auto;
  }

  .level-test-page__lead lead-form:not([hidden]) {
    display: block;
    margin-top: 32px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: 32px;
    background: var(--color-cream);
    box-shadow: 0 24px 48px rgb(120 40 0 / 0.25);
  }
</style>
