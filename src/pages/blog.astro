---
import BaseLayout from '@layouts/BaseLayout.astro';
import { BlogList, EmaTip, getPublishedPosts } from '@features/blog';
import Eyebrow from '@shared/ui/Eyebrow.astro';
import Footer from '@shared/ui/Footer.astro';
import Header from '@shared/ui/Header.astro';

const posts = await getPublishedPosts();
---
<BaseLayout
  title="Blog: sfaturi de engleză pentru părinți"
  description="Sfaturi pentru părinți: cum îți ajuți copilul cu engleza acasă, fără teme în plus, și cum alegi un curs potrivit pentru vârsta lui."
  crumbs={[{ name: 'Blog', path: '/blog/' }]}
>
  <Header active="blog" />
  <main id="continut" tabindex="-1" class="container blog-page">
    <Eyebrow>Blog</Eyebrow>
    <h1>Sfaturi pentru părinți</h1>
    <p class="blog-page__lead">Idei scurte despre cum îți ajuți copilul cu engleza acasă, fără teme în plus.</p>
    <BlogList posts={posts} />
    <EmaTip />
  </main>
  <Footer />
</BaseLayout>

<style>
  .blog-page {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-block: var(--space-section);
  }

  .blog-page > :nth-child(n + 4) {
    margin-top: 16px;
  }

  .blog-page h1 {
    font-size: var(--text-h1);
    text-wrap: balance;
  }

  .blog-page__lead {
    max-width: 600px;
    margin: 0;
    font-size: 1.1875rem;
  }
</style>
