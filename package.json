{
  "name": "englishminds-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:server": "node scripts/build-server.mjs",
    "dev:server": "npm run build:server && node --env-file=.env dist-server/app.cjs",
    "check": "astro check",
    "test": "vitest run",
    "lint": "eslint .",
    "deps": "depcruise src server --config .dependency-cruiser.cjs --ts-config tsconfig.json",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "test:staging": "vitest run --config vitest.staging.config.ts",
    "test:preview": "vitest run --config vitest.preview.config.ts",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "verify": "npm run lint && npm run check && npm run test && npm run deps && npm run build && npm run test:dist && npm run build:server && npm run test:staging && npm run test:preview"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "astro": "7.3.8",
    "mysql2": "3.24.4",
    "nodemailer": "10.0.10",
    "valibot": "1.5.0",
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "0.4.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "satteri": "0.10.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
